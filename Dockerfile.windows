FROM eclipse-temurin:25-jdk-windowsservercore-ltsc2022

WORKDIR C:\server

EXPOSE 25565

RUN powershell -NoProfile -Command \   
    Invoke-WebRequest -Uri 'https://piston-data.mojang.com/v1/objects/823e2250d24b3ddac457a60c92a6a941943fcd6a/server.jar' -OutFile 'C:\server\Server.jar'

WORKDIR C:\data

CMD ["java", "-Xmx4G", "-Xms4G", "-jar", "/server/Server.jar", "nogui"]
